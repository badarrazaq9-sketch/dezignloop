# DezignLoop environment variables
# Copy this file to .env.local for local development, or set the same names
# in Vercel (Project → Settings → Environment Variables) for production.
# Never commit real values.

# ── Admin panel (/admin) ─────────────────────────────────────────────
# Email of the single admin user allowed into the dashboard.
ADMIN_EMAIL=
# Password for the admin user. Login fails closed while this is unset.
ADMIN_PASSWORD=
# Optional: secret used to sign admin session cookies. When unset, ADMIN_PASSWORD is used as the signing key.
SESSION_SECRET=

# ── Supabase (lead database) ─────────────────────────────────────────
# Project URL, from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# Service role key, from Supabase → Project Settings → API. Server-only: it bypasses RLS so the admin dashboard can read leads. Never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Already used by the existing site features ───────────────────────
# Public publishable (anon) key, from Supabase → Project Settings → API. Used for public form inserts; RLS allows anon INSERT only.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Gmail address that sends and receives lead notification emails.
EMAIL_USER=
# Gmail app password for EMAIL_USER.
EMAIL_PASSWORD=
